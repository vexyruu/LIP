# GCP
GCP_PROJECT_ID=your-gcp-project-id

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=mlip
POSTGRES_CONN=postgres://postgres:postgres@localhost:5432/mlip

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password

# Redis
REDIS_ADDR=localhost:6379

# Pub/Sub topics
PUBSUB_TOPIC_LISTING_CREATED=listing-created

# listing-service
PORT=8080

# analysis-worker
PUBSUB_SUBSCRIPTION=listing-created-sub