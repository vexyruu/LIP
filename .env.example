# GCP (local: use emulator)
GCP_PROJECT_ID=local-dev
PUBSUB_EMULATOR_HOST=localhost:8085

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=mlip
POSTGRES_CONN=postgres://postgres:postgres@localhost:5432/mlip

# Neo4j (matches docker-compose default)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme

# Redis
REDIS_ADDR=localhost:6379

# Pub/Sub
PUBSUB_TOPIC_LISTING_CREATED=listing-created
PUBSUB_SUBSCRIPTION=listing-created-sub

# Service ports. PORT is read per-process; set it in each service's own
# environment (start-dev.ps1 does this). Do NOT export a single shared PORT
# here or services will collide.
#   listing-service -> 8080
#   fraud-service   -> 8081

# analysis-worker
FRAUD_SERVICE_URL=http://localhost:8081
ML_SERVICE_ADDR=localhost:50051

# MinIO / S3 (listing-service image uploads)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=mlip-listings
S3_USE_SSL=false
UPLOAD_PUBLIC_BASE_URL=http://localhost:9000/mlip-listings
ALLOW_EXTERNAL_IMAGE_URLS=true

# Fraud risk formula weights (component + pagerank + velocity must sum to 1.0)
WEIGHT_COMPONENT_SIZE=0.4
WEIGHT_PAGERANK_PROXIMITY=0.4
WEIGHT_VELOCITY=0.2
